# reClain Business (business.reclain.com). Copy this file to .env.local and fill it in. Never commit .env.local.
# Leave the Supabase lines empty to run in demo mode (sample data, pretend login).

# This app's own address, without a trailing slash. Locally: http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Where the two apps live, so links between them work. Locally the customer site is on 3000.
NEXT_PUBLIC_CUSTOMER_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_URL=http://localhost:3001
# Once both apps run on reclain.com and business.reclain.com, set this to ".reclain.com" in
# BOTH apps so one log-in covers both. Leave empty on localhost and on *.vercel.app addresses.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# Supabase → Project Settings → API Keys (the same three values as the customer site)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (server only).
SUPABASE_SECRET_KEY=

# SMS: "console" (prints to the server log, default) or "africastalking". The business app
# texts a customer when a venue cancels their booking, so use the same values as the customer site.
SMS_PROVIDER=console
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Force demo mode even when Supabase keys are set (1 = on)
NEXT_PUBLIC_RECLAIN_DEMO=
