# The customer site (reclain.com). Copy this file to .env.local and fill it in. Never commit .env.local.
# Leave the Supabase lines empty to run in demo mode (sample data, pretend login).

# This app's own address, without a trailing slash. Locally: http://localhost:3000
# Must be the public https address in production: it is Flutterwave's return address, the
# email-link address and the link in every SMS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the two apps live, so links between them work. Locally the business app is on 3001.
NEXT_PUBLIC_CUSTOMER_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_URL=http://localhost:3001
# Once both apps run on reclain.com and business.reclain.com, set this to ".reclain.com" in
# BOTH apps so one log-in covers both. Leave empty on localhost and on *.vercel.app addresses.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# Supabase → Project Settings → API Keys (the same three values in both apps)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (server only). Needed for payments, webhooks and reminders.
SUPABASE_SECRET_KEY=

# Payments: "mock" (pretend: an Approve/Decline page, no real money) or "flutterwave".
# Demo mode (no Supabase keys) always uses mock. With a real database, leave this empty or
# misspell it and MoMo, Airtel and card are switched off (customers see cash only), so pretend
# payments never reach real customers by accident. Use mock only while you test.
PAYMENT_PROVIDER=mock
# Flutterwave → Settings → API Keys (use the TEST keys first)
FLW_SECRET_KEY=
# Flutterwave → Settings → Webhooks → "Secret hash" (any long random text you choose)
FLW_WEBHOOK_HASH=

# SMS: "console" (prints to the server log, default) or "africastalking"
SMS_PROVIDER=console
# Africa's Talking → Settings → API Key. Use username "sandbox" for testing.
AT_USERNAME=
AT_API_KEY=
# Optional sender name approved by Africa's Talking (e.g. RECLAIN)
AT_SENDER_ID=

# Protects /api/cron/reminders. Vercel sends it automatically when set in the project.
CRON_SECRET=

# Force demo mode even when Supabase keys are set (1 = on)
NEXT_PUBLIC_RECLAIN_DEMO=
